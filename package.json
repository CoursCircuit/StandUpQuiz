{
  "name": "standup-quiz",
  "productName": "StandUp Quiz",
  "version": "2.2.1",
  "main": "main.js",
  "description": "Le quiz en équipes pour toutes les branches, pensé pour la classe.",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check projection-preload.js && node --check storage.js && node --check core.js && node --check view.js && node --check script.js && node --check projection.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/package-mac.js",
    "build:dir": "node scripts/package-mac.js --dir"
  },
  "keywords": [],
  "author": "CoursCircuit",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.sbovat.standupquiz",
    "productName": "StandUp Quiz",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "projection-preload.js",
      "storage.js",
      "core.js",
      "view.js",
      "script.js",
      "projection.js",
      "index.html",
      "projection.html",
      "style.css",
      "assets/**/*",
      "LICENSE.txt"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "${productName}"
    }
  }
}
